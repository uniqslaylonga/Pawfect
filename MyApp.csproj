<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<NoWarn>$(NoWarn);WFO1000</NoWarn>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyApp</RootNamespace>
    <AssemblyName>Pawfect</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
  </ItemGroup>

  <!-- Google Vision key: paste it into vision.key (one line). It is copied next to Pawfect.exe on every build.
       The file is in .gitignore, so the key never goes to GitHub. -->
  <ItemGroup>
    <None Update="vision.key" CopyToOutputDirectory="PreserveNewest" Condition="Exists('vision.key')" />
    <None Update="smtp.config" CopyToOutputDirectory="PreserveNewest" Condition="Exists('smtp.config')" />
  </ItemGroup>

</Project>
