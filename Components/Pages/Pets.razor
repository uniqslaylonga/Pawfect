@page "/pets"
@inject PawfectDbContext Db
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<PageTitle>My Pets - Pawfect</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" Class="mb-4">My Pets</MudText>

        <MudPaper Class="pa-4 mb-6" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Add a pet</MudText>
            <MudForm @ref="_form">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_newPet.PetName" Label="Name" Required="true"
                                      RequiredError="Name is required" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_newPet.Species" Label="Species" Required="true"
                                   RequiredError="Pick a species">
                            @foreach (var s in _species)
                            {
                                <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_newPet.Breed" Label="Breed" Required="true"
                                      RequiredError="Breed is required" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal" @bind-Value="_newPet.Weight" Label="Weight (kg)" Min="0.1m" Max="200m" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_newPet.MedicalConditions" Label="Medical conditions (optional)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_newPet.BehavioralTraits" Label="Behavioral traits (optional)" />
                    </MudItem>
                </MudGrid>
            </MudForm>
            <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddPetAsync"
                       Disabled="_saving">Save pet</MudButton>
        </MudPaper>

        <MudTable Items="_pets" Hover="true" Dense="true" Elevation="1" Loading="_loading">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Species</MudTh>
                <MudTh>Breed</MudTh>
                <MudTh>Weight (kg)</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="pet">
                <MudTd DataLabel="Name">@pet.PetName</MudTd>
                <MudTd DataLabel="Species">@pet.Species</MudTd>
                <MudTd DataLabel="Breed">@pet.Breed</MudTd>
                <MudTd DataLabel="Weight (kg)">@pet.Weight</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemovePetAsync(pet))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No pets yet. Add your first one above.</MudText>
            </NoRecordsContent>
        </MudTable>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">Please log in (top right) to see your pets.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly string[] _species = { "Dog", "Cat", "Other" };
    private List<Pet> _pets = new();
    private Pet _newPet = new();
    private MudForm _form = default!;
    private string? _userId;
    private string? _userName;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _userName = state.User.Identity?.Name;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        if (_userId is not null)
        {
            _pets = await Db.Pets
                .Where(p => p.OwnerId == _userId && p.IsActive)
                .OrderBy(p => p.PetName)
                .ToListAsync();
        }
        _loading = false;
    }

    private async Task AddPetAsync()
    {
        if (_userId is null) return;

        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            _newPet.OwnerId = _userId;
            Db.Pets.Add(_newPet);
            Db.AuditLogs.Add(new AuditLog { Action = "Pet added", Details = $"{_newPet.PetName} ({_newPet.Species})", UserName = _userName });
            await Db.SaveChangesAsync();
            Snackbar.Add($"{_newPet.PetName} added.", Severity.Success);
            _newPet = new Pet();
            await _form.ResetAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemovePetAsync(Pet pet)
    {
        // Soft delete, same idea as the IsActive flag on the model
        pet.IsActive = false;
        Db.AuditLogs.Add(new AuditLog { Action = "Pet removed", Details = pet.PetName, UserName = _userName });
        await Db.SaveChangesAsync();
        Snackbar.Add($"{pet.PetName} removed.", Severity.Info);
        await LoadAsync();
    }
}
