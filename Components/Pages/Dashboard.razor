@page "/admin"
@layout AdminLayout
@using System.Globalization
@using System.Text
@using Pawfect.Services
@inject DashboardService DashboardSvc
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Dashboard - Pawfect Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Dashboard</h1>
        <p>Welcome back, Admin! Here's what's happening today.</p>
    </div>
    <AdminTopTools />
</div>

<AuthorizeView Roles="Admin">
    <Authorized>
        @if (_data is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <div class="grid">
                @foreach (var s in _stats)
                {
                    <div class="card stat">
                        <div class="ico"><MudIcon Icon="@s.Icon" Color="Color.Inherit" /></div>
                        <div>
                            <div class="label">@s.Label</div>
                            <div class="value">@s.Value.ToString("N0")</div>
                            <div class="trend @s.TrendClass">@s.TrendText</div>
                        </div>
                    </div>
                }

                <div class="card span2">
                    <div class="card-head">
                        <div>
                            <div class="card-title"><span class="ico sm"><MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" Color="Color.Inherit" /></span> Gross Revenue Summary</div>
                            <div class="card-sub">Total gross revenue from services and retail sales</div>
                        </div>
                        <div class="seg">
                            @foreach (var m in _modes)
                            {
                                <button type="button" class="@(_mode == m ? "on" : "")" @onclick="() => _mode = m">@m</button>
                            }
                        </div>
                    </div>
                    @LineChart(Points)
                    @if (Points.All(p => p.Value == 0))
                    {
                        <div class="empty">No revenue recorded for this period (₱0).</div>
                    }
                </div>

                <div class="card">
                    <div class="card-title"><span class="ico sm"><MudIcon Icon="@Icons.Material.Outlined.PieChart" Size="Size.Small" Color="Color.Inherit" /></span> Grooming Appointments vs. Walk-in Retail Sales</div>
                    <div class="card-sub">Last 30 days</div>
                    <div class="donut">@Donut(_data.Appointments, _data.Sales)</div>
                    <div class="legend">
                        <div><span class="dot blue"></span> Grooming Appointments <b>@ApptPct</b> <small>@_data.Appointments appointments</small></div>
                        <div><span class="dot light"></span> Walk-in Retail Sales <b>@SalesPct</b> <small>@_data.Sales sales</small></div>
                    </div>
                </div>

                <div class="card span2">
                    <div class="card-head">
                        <div>
                            <div class="card-title"><span class="ico sm"><MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Color="Color.Inherit" /></span> Revenue Overview</div>
                            <div class="card-sub">Daily, weekly, and monthly gross revenue (₱)</div>
                        </div>
                        <div class="keys">
                            <span><i style="background:#3B82C4"></i>Daily</span>
                            <span><i style="background:#A9C6E8"></i>Weekly</span>
                            <span><i style="background:#DCE5F0"></i>Monthly</span>
                        </div>
                    </div>
                    @BarChart(_data.Overview)
                    @if (_data.Overview.All(b => b.Daily == 0 && b.Weekly == 0 && b.Monthly == 0))
                    {
                        <div class="empty">No revenue recorded yet (₱0).</div>
                    }
                </div>

                <div class="card quick">
                    <div class="card-title"><span class="ico sm"><MudIcon Icon="@Icons.Material.Outlined.Speed" Size="Size.Small" Color="Color.Inherit" /></span> Quick Metrics</div>
                    @foreach (var s in _stats)
                    {
                        <div class="qm">
                            <span class="ico sm"><MudIcon Icon="@s.Icon" Size="Size.Small" Color="Color.Inherit" /></span>
                            <span class="qm-label">@s.Label</span>
                            <span class="qm-val">@s.Value.ToString("N0")<small class="trend @s.TrendClass">@s.TrendText</small></span>
                        </div>
                    }
                </div>

                <div class="side">
                    <div class="side-title"><MudIcon Icon="@Icons.Material.Outlined.Notifications" Size="Size.Small" Color="Color.Inherit" /> Alerts</div>

                    <div class="alert low @(_data.LowStock.Count == 0 ? "clear" : "")">
                        <div class="alert-title"><MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small" Color="Color.Inherit" /> Low Stock Alert</div>
                        <div class="alert-body">@(_data.LowStock.Count == 0 ? "No low stock items." : string.Join(", ", _data.LowStock))</div>
                    </div>

                    <div class="alert expiry @(_data.NearExpiry.Count == 0 ? "clear" : "")">
                        <div class="alert-title"><MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Color="Color.Inherit" /> Near Expiry / FIFO Alert</div>
                        <div class="alert-body">
                            @if (_data.NearExpiry.Count == 0)
                            {
                                <span>No items near expiry.</span>
                            }
                            else
                            {
                                foreach (var line in _data.NearExpiry)
                                {
                                    <div>@line</div>
                                }
                            }
                        </div>
                    </div>

                    <div class="card activity">
                        <div class="card-title"><span class="ico sm"><MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" Color="Color.Inherit" /></span> Recent Activity / Audit Trail</div>
                        @if (_data.Activity.Count == 0)
                        {
                            <div class="empty">No activity recorded yet.</div>
                        }
                        else
                        {
                            foreach (var a in _data.Activity)
                            {
                                <div class="act">
                                    <span class="act-ico @a.Kind">
                                        <MudIcon Icon="@ActivityIcon(a.Kind)" Size="Size.Small" Color="Color.Inherit" />
                                    </span>
                                    <div class="act-text">
                                        <div class="act-title">@a.Title</div>
                                        <div class="act-detail">@a.Detail</div>
                                    </div>
                                    <div class="act-when">@a.When</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">This page is for administrators only. Please log in with an admin account.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private record Stat(string Label, int Value, string Icon, string TrendText, string TrendClass);

    private readonly string[] _modes = { "Daily", "Weekly", "Monthly" };
    private string _mode = "Daily";
    private DashboardData? _data;
    private List<Stat> _stats = new();

    private IReadOnlyList<ChartPoint> Points => _data is null
        ? new List<ChartPoint>()
        : _mode switch
        {
            "Weekly" => _data.Weekly,
            "Monthly" => _data.Monthly,
            _ => _data.Daily
        };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole("Admin")) return;

        _data = await DashboardSvc.LoadAsync();

        string petText = "N/A vs. last month", petClass = "na";
        if (_data.PetsTrendPct is double pct)
        {
            petClass = pct >= 0 ? "up" : "down";
            petText = $"{(pct >= 0 ? "↑" : "↓")} {Math.Abs(pct):0}% vs. last month";
        }

        _stats = new List<Stat>
        {
            new("Total Registered Customers", _data.Customers, Icons.Material.Outlined.People, "N/A vs. last month", "na"),
            new("Active Staff", _data.StaffCount, Icons.Material.Outlined.Badge, "N/A vs. last month", "na"),
            new("Active Pets", _data.Pets, Icons.Material.Outlined.Pets, petText, petClass)
        };
    }

    private string ApptPct => PctText(true);
    private string SalesPct => PctText(false);

    private string PctText(bool appointments)
    {
        if (_data is null) return "N/A";
        var total = _data.Appointments + _data.Sales;
        if (total == 0) return "N/A";
        var a = (int)Math.Round(_data.Appointments * 100.0 / total);
        return (appointments ? a : 100 - a) + "%";
    }

    private static string ActivityIcon(string kind) => kind switch
    {
        "success" => Icons.Material.Outlined.CheckCircle,
        "delete" => Icons.Material.Outlined.Delete,
        _ => Icons.Material.Outlined.Inventory2
    };

    // ---------- charts (plain SVG, no chart library) ----------
    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Peso(decimal v) => "₱" + v.ToString("N0", CultureInfo.InvariantCulture);

    private static decimal NiceMax(decimal max)
    {
        if (max <= 0) return 1;
        var exp = Math.Pow(10, Math.Floor(Math.Log10((double)max)));
        var f = (double)max / exp;
        var nf = f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10;
        return (decimal)(nf * exp);
    }

    private static void Axis(StringBuilder sb, bool has, double top, double L, double R, double T, double W, double plotH)
    {
        var steps = has ? 4 : 0;
        for (var k = 0; k <= steps; k++)
        {
            var frac = steps == 0 ? 0 : k / (double)steps;
            var y = T + plotH * (1 - frac);
            sb.Append($"<line x1='{F(L)}' x2='{F(W - R)}' y1='{F(y)}' y2='{F(y)}' stroke='#E6ECF5'/>");
            sb.Append($"<text x='{F(L - 8)}' y='{F(y + 4)}' text-anchor='end' font-size='11' fill='#6B7A90'>{Peso((decimal)(top * frac))}</text>");
        }
    }

    private static MarkupString LineChart(IReadOnlyList<ChartPoint> pts)
    {
        const double W = 600, H = 250, L = 64, R = 18, T = 14, B = 30;
        var plotW = W - L - R;
        var plotH = H - T - B;
        var max = pts.Count == 0 ? 0m : pts.Max(p => p.Value);
        var has = max > 0;
        var top = (double)NiceMax(max);
        var n = pts.Count;

        double X(int i) => L + plotW * (n <= 1 ? 0.5 : i / (double)(n - 1));
        double Y(decimal v) => T + plotH * (1 - (has ? (double)v / top : 0));

        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {F(W)} {F(H)}' width='100%' style='display:block;height:auto' role='img'>");
        Axis(sb, has, top, L, R, T, W, plotH);

        if (n > 0)
        {
            var line = string.Join(" ", pts.Select((p, i) => $"{F(X(i))},{F(Y(p.Value))}"));
            var baseY = T + plotH;
            sb.Append($"<polygon points='{F(X(0))},{F(baseY)} {line} {F(X(n - 1))},{F(baseY)}' fill='#3B82C4' fill-opacity='0.12'/>");
            sb.Append($"<polyline points='{line}' fill='none' stroke='#3B82C4' stroke-width='2.5' stroke-linejoin='round'/>");
            for (var i = 0; i < n; i++)
            {
                sb.Append($"<circle cx='{F(X(i))}' cy='{F(Y(pts[i].Value))}' r='4' fill='#3B82C4'><title>{pts[i].Label}: {Peso(pts[i].Value)}</title></circle>");
                sb.Append($"<text x='{F(X(i))}' y='{F(H - 8)}' text-anchor='middle' font-size='11' fill='#6B7A90'>{pts[i].Label}</text>");
            }
        }
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    private static MarkupString BarChart(IReadOnlyList<BarGroup> groups)
    {
        const double W = 600, H = 250, L = 64, R = 18, T = 14, B = 30;
        var plotW = W - L - R;
        var plotH = H - T - B;
        var max = groups.Count == 0 ? 0m : groups.Max(g => Math.Max(g.Daily, Math.Max(g.Weekly, g.Monthly)));
        var has = max > 0;
        var top = (double)NiceMax(max);
        var n = groups.Count;
        var colors = new[] { "#3B82C4", "#A9C6E8", "#DCE5F0" };

        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {F(W)} {F(H)}' width='100%' style='display:block;height:auto' role='img'>");
        Axis(sb, has, top, L, R, T, W, plotH);

        if (n > 0)
        {
            var groupW = plotW / n;
            var barW = groupW * 0.2;
            for (var i = 0; i < n; i++)
            {
                var g = groups[i];
                var vals = new[] { g.Daily, g.Weekly, g.Monthly };
                var names = new[] { "Daily", "Weekly", "Monthly" };
                var startX = L + groupW * i + (groupW - barW * 3 - 4) / 2;
                for (var k = 0; k < 3; k++)
                {
                    var h = has ? plotH * (double)vals[k] / top : 0;
                    var x = startX + k * (barW + 2);
                    sb.Append($"<rect x='{F(x)}' y='{F(T + plotH - h)}' width='{F(barW)}' height='{F(h)}' rx='2' fill='{colors[k]}'><title>{g.Label} {names[k]}: {Peso(vals[k])}</title></rect>");
                }
                sb.Append($"<text x='{F(L + groupW * i + groupW / 2)}' y='{F(H - 8)}' text-anchor='middle' font-size='11' fill='#6B7A90'>{g.Label}</text>");
            }
        }
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    private static MarkupString Donut(int appts, int sales)
    {
        const double r = 70;
        var c = 2 * Math.PI * r;
        var total = appts + sales;
        var frac = total == 0 ? 0 : appts / (double)total;
        var dash = c * frac;

        var sb = new StringBuilder();
        sb.Append("<svg viewBox='0 0 200 200' width='180' height='180' role='img'>");
        sb.Append($"<circle cx='100' cy='100' r='{F(r)}' fill='none' stroke='#DCE7F5' stroke-width='18'/>");
        if (total > 0)
            sb.Append($"<circle cx='100' cy='100' r='{F(r)}' fill='none' stroke='#3B82C4' stroke-width='18' stroke-dasharray='{F(dash)} {F(c - dash)}' transform='rotate(-90 100 100)'/>");
        var center = total == 0 ? "N/A" : $"{Math.Round(frac * 100):0}%";
        sb.Append($"<text x='100' y='104' text-anchor='middle' font-size='28' font-weight='700' fill='#1F3350'>{center}</text>");
        sb.Append("<text x='100' y='124' text-anchor='middle' font-size='10' fill='#6B7A90'>Grooming Appointments</text>");
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }
}