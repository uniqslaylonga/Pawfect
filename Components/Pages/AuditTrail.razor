@page "/admin/audit"
@layout AdminLayout
@using System.Globalization
@using Pawfect.Services
@inject AuditTrailService AuditSvc
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Audit Trail - Pawfect Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Audit Trail / Activity Logs</h1>
        <p>Track all system actions, approvals, updates, and record changes.</p>
    </div>
    <AdminTopTools />
</div>

<AuthorizeView Roles="Admin">
    <Authorized>
        @if (_openMenu is not null)
        {
            <div class="menu-away" @onclick="() => _openMenu = null"></div>
        }

        <div class="layout">
            <div class="main-col">
                <section class="panel head-card">
                    <div class="panel-title">
                        <span class="ico"><MudIcon Icon="@Icons.Material.Outlined.History" Color="Color.Inherit" /></span>
                        <div>
                            <h2>Activity Overview</h2>
                            <p>Track system activities, today's actions, pending approvals, and active users.</p>
                        </div>
                    </div>
                    <div class="range">
                        <input type="date" title="From" @bind="_from" @bind:after="OnRangeChanged" />
                        <span>to</span>
                        <input type="date" title="To" @bind="_to" @bind:after="OnRangeChanged" />
                    </div>
                </section>

                <div class="stats">
                    @foreach (var c in Cards)
                    {
                        <div class="stat">
                            <div class="stat-top">
                                <span class="ico sm @c.Tone"><MudIcon Icon="@c.Icon" Size="Size.Small" Color="Color.Inherit" /></span>
                                <span class="stat-label">@c.Label</span>
                            </div>
                            <div class="stat-value">@c.Value</div>
                            <div class="trend @c.TrendClass">@c.Trend</div>
                        </div>
                    }
                </div>

                <section class="panel">
                    <div class="filters">
                        <div class="search">
                            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Color="Color.Inherit" />
                            <input type="text" placeholder="Search activity (user, action, description, reference...)" @bind="_search" @bind:event="oninput" @bind:after="OnFilterChanged" />
                        </div>
                    </div>
                    <div class="filters">
                        <select @bind="_user" @bind:after="OnFilterChanged">
                            <option value="">All Users</option>
                            @foreach (var u in UserOptions) { <option value="@u">@u</option> }
                        </select>
                        <select @bind="_module" @bind:after="OnFilterChanged">
                            <option value="">All Modules</option>
                            @foreach (var m in ModuleOptions) { <option value="@m">@m</option> }
                        </select>
                        <select @bind="_type" @bind:after="OnFilterChanged">
                            <option value="">All Action Types</option>
                            @foreach (var t in AuditTrailService.ActionTypes) { <option value="@t">@t</option> }
                        </select>
                        @if (HasFilters)
                        {
                            <button type="button" class="chip" @onclick="ClearFilters">Clear filters</button>
                        }
                    </div>

                    <div class="table-title"><MudIcon Icon="@Icons.Material.Outlined.Article" Size="Size.Small" Color="Color.Inherit" /> System Activity Logs</div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th class="chk"><input type="checkbox" checked="@AllPageSelected" @onchange="TogglePage" /></th>
                                    <th>Date &amp; Time</th><th>User</th><th>Action</th><th>Module</th>
                                    <th>Description</th><th>Reference</th><th>Status</th><th class="right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in PagedEntries)
                                {
                                    <tr>
                                        <td class="chk"><input type="checkbox" checked="@_selected.Contains(e.Id)" @onchange="() => ToggleSelect(e.Id)" /></td>
                                        <td>
                                            <div class="dt">@DateText(e.Local)</div>
                                            <div class="muted">@TimeText(e.Local)</div>
                                        </td>
                                        <td>
                                            <div class="who">
                                                <span class="avatar av-@Slug(e.Role)"><MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Color="Color.Inherit" /></span>
                                                <span class="who-text">
                                                    <span class="who-name">@e.User</span>
                                                    <span class="muted">(@e.Role)</span>
                                                </span>
                                            </div>
                                        </td>
                                        <td><span class="pill ac-@Slug(e.ActionType)">@e.ActionType</span></td>
                                        <td>@e.Module</td>
                                        <td class="desc">@e.Description</td>
                                        <td class="ref">@e.Reference</td>
                                        <td><span class="pill ac-@Slug(e.Status)">@e.Status</span></td>
                                        <td class="right actions">@RowActions(e)</td>
                                    </tr>
                                }
                                @if (!PagedEntries.Any())
                                {
                                    <tr><td colspan="9" class="empty">@EmptyText</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="table-foot">
                        <span>@ShowingText()</span>
                        @Pager()
                    </div>
                </section>
            </div>

            <aside class="side-col">
                <section class="panel side">
                    <div class="side-head">
                        <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" Color="Color.Inherit" /> QUICK FILTERS</h3>
                        <button type="button" class="link" @onclick="ResetAll">View All →</button>
                    </div>
                    <button type="button" class="qf" @onclick="QuickToday">
                        <span class="qf-ico"><MudIcon Icon="@Icons.Material.Outlined.Today" Size="Size.Small" Color="Color.Inherit" /></span>
                        <span class="qf-label">Today</span>
                        <span class="qf-badge">@_data.TodayCount</span>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Inherit" />
                    </button>
                    <button type="button" class="qf" @onclick="QuickWeek">
                        <span class="qf-ico"><MudIcon Icon="@Icons.Material.Outlined.DateRange" Size="Size.Small" Color="Color.Inherit" /></span>
                        <span class="qf-label">This Week</span>
                        <span class="qf-badge">@_data.WeekCount</span>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Inherit" />
                    </button>
                    <button type="button" class="qf" @onclick='() => QuickType("Deleted")'>
                        <span class="qf-ico tone-red"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" Color="Color.Inherit" /></span>
                        <span class="qf-label">Critical Actions</span>
                        <span class="qf-badge">@CountOf("Deleted")</span>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Inherit" />
                    </button>
                    <button type="button" class="qf" @onclick='() => QuickType("Login")'>
                        <span class="qf-ico tone-purple"><MudIcon Icon="@Icons.Material.Outlined.Login" Size="Size.Small" Color="Color.Inherit" /></span>
                        <span class="qf-label">Login Activity</span>
                        <span class="qf-badge">@CountOf("Login")</span>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Inherit" />
                    </button>
                </section>

                <section class="panel side">
                    <div class="side-head">
                        <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.Bolt" Size="Size.Small" Color="Color.Inherit" /> RECENT ACTIVITY</h3>
                        <button type="button" class="link" @onclick="ResetAll">View All →</button>
                    </div>
                    @foreach (var e in _data.Recent)
                    {
                        <div class="tl-row">
                            <span class="tl-dot ac-@Slug(e.ActionType)"></span>
                            <div class="tl-body">
                                <small>@DateText(e.Local), @TimeText(e.Local)</small>
                                <b>@e.User: @e.RawAction</b>
                                <span class="ref">(@e.Reference)</span>
                            </div>
                        </div>
                    }
                    @if (_data.Recent.Count == 0)
                    {
                        <div class="empty left">No activity recorded yet.</div>
                    }
                </section>

                <section class="panel side">
                    <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.Summarize" Size="Size.Small" Color="Color.Inherit" /> AUDIT SUMMARY</h3>
                    <div class="sum-grid">
                        <div class="sum-tile"><span class="sum-ico tone-green"><MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" Size="Size.Small" Color="Color.Inherit" /></span><small>Created</small><b>@CountOf("Created")</b></div>
                        <div class="sum-tile"><span class="sum-ico tone-blue"><MudIcon Icon="@Icons.Material.Outlined.Sync" Size="Size.Small" Color="Color.Inherit" /></span><small>Updated</small><b>@CountOf("Updated")</b></div>
                        <div class="sum-tile"><span class="sum-ico tone-green"><MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Size="Size.Small" Color="Color.Inherit" /></span><small>Approved</small><b>@CountOf("Approved")</b></div>
                        <div class="sum-tile"><span class="sum-ico tone-red"><MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Inherit" /></span><small>Deleted</small><b>@CountOf("Deleted")</b></div>
                    </div>
                </section>

                <section class="panel side">
                    <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" Color="Color.Inherit" /> EXPORT LOGS</h3>
                    <div class="exp-grid">
                        <button type="button" class="exp-tile" @onclick="PrintLogs">
                            <span class="exp-ico pdf"><MudIcon Icon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" Color="Color.Inherit" /></span>
                            <b>Download PDF</b><small>(Full Report)</small>
                        </button>
                        <button type="button" class="exp-tile" @onclick="ExportCsv">
                            <span class="exp-ico xls"><MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Small" Color="Color.Inherit" /></span>
                            <b>Download Excel</b><small>(Transactions)</small>
                        </button>
                    </div>
                    <div class="hint">@ExportHint</div>
                </section>
            </aside>
        </div>

        @if (_message is not null)
        {
            <div class="toast" @onclick="() => _message = null">@_message</div>
        }

        @if (_detail is not null)
        {
            <div class="overlay" @onclick="() => _detail = null">
                <div class="modal" @onclick:stopPropagation="true">
                    <h3>Activity details</h3>
                    <div class="report">
                        @foreach (var line in DetailLines(_detail))
                        {
                            <div class="report-row"><span>@line.Label</span><span class="val">@line.Value</span></div>
                        }
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn-ghost" @onclick="() => _detail = null">Close</button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">This page is for administrators only. Please log in with an admin account.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const int PageSize = 8;
    private record StatCard(string Label, string Value, string Icon, string Tone, string Trend, string TrendClass);
    private record DetailLine(string Label, string Value);

    private AuditData _data = new();
    private DateOnly _from, _to;
    private string _actor = "Admin";

    private string _search = "", _user = "", _module = "", _type = "";
    private int _pageNo = 1;
    private readonly HashSet<int> _selected = new();

    private string? _openMenu, _message;
    private AuditEntry? _detail;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole("Admin")) return;
        _actor = state.User.Identity?.Name ?? "Admin";
        SetMonth();
        await Reload();
    }

    private void SetMonth()
    {
        var today = PhTime.Today;
        _from = new DateOnly(today.Year, today.Month, 1);
        _to = _from.AddMonths(1).AddDays(-1);
    }

    private async Task Reload()
    {
        _data = await AuditSvc.LoadAsync(_from, _to);
        var ids = _data.Entries.Select(e => e.Id).ToHashSet();
        _selected.RemoveWhere(id => !ids.Contains(id));
    }

    // ---------- derived data ----------
    private IEnumerable<StatCard> Cards
    {
        get
        {
            var total = _data.Entries.Count;
            var prev = _data.PreviousPeriodCount;
            string trend, cls;
            if (prev == 0) { trend = total == 0 ? "No activity yet" : "No earlier period to compare"; cls = "na"; }
            else
            {
                var pct = (total - prev) * 100.0 / prev;
                trend = Math.Round(pct) == 0 ? "No change vs. last period" : $"{(pct > 0 ? "↑" : "↓")} {Math.Abs(pct):0}% vs. last period";
                cls = Math.Round(pct) == 0 ? "na" : pct > 0 ? "up" : "down";
            }
            yield return new StatCard("Total Activities", total.ToString("N0"), Icons.Material.Outlined.Description, "", trend, cls);
            yield return new StatCard("Today", _data.TodayCount.ToString("N0"), Icons.Material.Outlined.Today, "tone-blue", "Logged today", "na");
            yield return new StatCard("Pending Actions", _data.PendingActions.ToString("N0"), Icons.Material.Outlined.WarningAmber, "tone-amber",
                _data.PendingActions == 0 ? "Nothing waiting" : "Appointments & transactions to review", _data.PendingActions == 0 ? "up" : "na");
            yield return new StatCard("System Users", _data.SystemUsers.ToString("N0"), Icons.Material.Outlined.Groups, "tone-purple", "Admin and staff accounts", "na");
        }
    }

    private IEnumerable<string> UserOptions => _data.Entries.Select(e => e.User).Distinct().OrderBy(u => u);
    private IEnumerable<string> ModuleOptions => _data.Entries.Select(e => e.Module).Distinct().OrderBy(m => m);
    private bool HasFilters => _search != "" || _user != "" || _module != "" || _type != "";
    private int CountOf(string type) => _data.Entries.Count(e => e.ActionType == type);

    private IEnumerable<AuditEntry> Filtered => _data.Entries.Where(e =>
        (_user == "" || e.User == _user) &&
        (_module == "" || e.Module == _module) &&
        (_type == "" || e.ActionType == _type) &&
        (string.IsNullOrWhiteSpace(_search) ||
            e.User.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            e.Description.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            e.Reference.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            e.Module.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count() / (double)PageSize));
    private int CurrentPage => Math.Min(_pageNo, PageCount);
    private IEnumerable<AuditEntry> PagedEntries => Filtered.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private string EmptyText => _data.Entries.Count == 0
        ? "No activity in this period."
        : "No activity matches your filters.";

    private string ShowingText()
    {
        var total = Filtered.Count();
        if (total == 0) return "Showing 0 of 0 activities";
        var from = (CurrentPage - 1) * PageSize + 1;
        var to = Math.Min(CurrentPage * PageSize, total);
        return $"Showing {from}–{to} of {total} activities";
    }

    // ---------- filters / selection ----------
    private void OnFilterChanged()
    {
        _pageNo = 1;
        _selected.Clear();
    }

    private async Task OnRangeChanged()
    {
        if (_to < _from) _to = _from;
        _pageNo = 1;
        _selected.Clear();
        await Reload();
    }

    private void ClearFilters()
    {
        _search = _user = _module = _type = "";
        OnFilterChanged();
    }

    private async Task ResetAll()
    {
        SetMonth();
        ClearFilters();
        await Reload();
    }

    private async Task QuickToday()
    {
        _from = _to = PhTime.Today;
        ClearFilters();
        await Reload();
    }

    private async Task QuickWeek()
    {
        var today = PhTime.Today;
        _from = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        _to = today;
        ClearFilters();
        await Reload();
    }

    private void QuickType(string type)
    {
        ClearFilters();
        _type = type;
    }

    private bool AllPageSelected => PagedEntries.Any() && PagedEntries.All(e => _selected.Contains(e.Id));

    private void TogglePage()
    {
        var ids = PagedEntries.Select(e => e.Id).ToList();
        if (AllPageSelected) foreach (var id in ids) _selected.Remove(id);
        else foreach (var id in ids) _selected.Add(id);
    }

    private void ToggleSelect(int id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
    }

    private RenderFragment Pager() => __builder =>
    {
        var cur = CurrentPage;
        var pages = PageCount;
        var start = Math.Max(1, Math.Min(cur - 2, pages - 4));
        var end = Math.Min(pages, start + 4);
        <div class="pager">
            <button type="button" disabled="@(cur <= 1)" @onclick="() => _pageNo = cur - 1">‹</button>
            @for (var n = start; n <= end; n++)
            {
                var pg = n;
                <button type="button" class="@(pg == cur ? "on" : "")" @onclick="() => _pageNo = pg">@pg</button>
            }
            <button type="button" disabled="@(cur >= pages)" @onclick="() => _pageNo = cur + 1">›</button>
        </div>
    };

    private RenderFragment RowActions(AuditEntry e) => __builder =>
    {
        var key = "e:" + e.Id;
        <span class="menu-host">
            <button type="button" class="icon-btn" title="More" @onclick="() => ToggleMenu(key)">
                <MudIcon Icon="@Icons.Material.Outlined.MoreHoriz" Size="Size.Small" Color="Color.Inherit" />
            </button>
            @if (_openMenu == key)
            {
                <div class="menu">
                    <button type="button" @onclick="() => OpenDetail(e)">View details</button>
                </div>
            }
        </span>
    };

    private void ToggleMenu(string key) => _openMenu = _openMenu == key ? null : key;

    private void OpenDetail(AuditEntry e)
    {
        _openMenu = null;
        _detail = e;
    }

    private static List<DetailLine> DetailLines(AuditEntry e) => new()
    {
        new("Date & time", $"{DateText(e.Local)} {TimeText(e.Local)}"),
        new("User", e.User),
        new("Role", e.Role),
        new("Action type", e.ActionType),
        new("Module", e.Module),
        new("Action", e.RawAction),
        new("Details", string.IsNullOrWhiteSpace(e.Details) ? "—" : e.Details!),
        new("Reference", e.Reference),
        new("Status", e.Status)
    };

    // ---------- helpers ----------
    private static string DateText(DateTime local) => local.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    private static string TimeText(DateTime local) => local.ToString("hh:mm tt", CultureInfo.InvariantCulture);
    private static string Slug(string? c) => new string((c ?? "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
    private static string DateText(DateOnly d) => d.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);

    private void Flash(string text) => _message = text;

    // ---------- export ----------
    private static readonly string[] Headers =
        { "Date & Time", "User", "Role", "Action", "Module", "Description", "Reference", "Status" };

    private string ExportHint =>
        (_selected.Count > 0 ? $"Exports use the current filters and your {_selected.Count} selected row(s). " : "Exports use the current filters. ")
        + "PDF opens your browser's print dialog - choose \"Save as PDF\". Excel downloads a .csv file that opens in Excel.";

    private IEnumerable<AuditEntry> ExportSource =>
        _selected.Count > 0 ? Filtered.Where(e => _selected.Contains(e.Id)) : Filtered;

    private List<string[]> Rows() => ExportSource.Select(e => new[]
    {
        e.Local.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture), e.User, e.Role, e.ActionType,
        e.Module, e.Description, e.Reference, e.Status
    }).ToList();

    private async Task ExportCsv()
    {
        await JS.InvokeVoidAsync("pawfectExport.download", $"pawfect-audit-trail-{_from:yyyyMMdd}-{_to:yyyyMMdd}.csv",
            ExportHelper.Csv(Headers, Rows()), "text/csv;charset=utf-8");
        Flash("Export downloaded.");
    }

    private async Task PrintLogs()
    {
        var summary = new List<string[]>
        {
            new[] { "Created", CountOf("Created").ToString() },
            new[] { "Updated", CountOf("Updated").ToString() },
            new[] { "Approved", CountOf("Approved").ToString() },
            new[] { "Deleted", CountOf("Deleted").ToString() },
            new[] { "Login", CountOf("Login").ToString() }
        };
        var html = ExportHelper.Html("Pawfect - Audit Trail / Activity Logs",
            $"Period: {DateText(_from)} to {DateText(_to)}  |  Generated {PhTime.Now.ToString("MMM d, yyyy hh:mm tt", CultureInfo.InvariantCulture)} by {_actor}",
            new[]
            {
                new ExportSection("Audit summary", new[] { "Action type", "Entries" }, summary),
                new ExportSection("System activity logs", Headers, Rows())
            });
        await JS.InvokeVoidAsync("pawfectExport.print", html);
    }
}
