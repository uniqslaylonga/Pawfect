@page "/admin/inventory"
@layout AdminLayout
@using Pawfect.Services
@inject InventoryService InventorySvc
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Inventory &amp; FIFO - Pawfect Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Inventory &amp; FIFO Management</h1>
        <p>Manage your stock, track batch entries, and ensure FIFO (First In, First Out)</p>
    </div>
    <AdminTopTools />
</div>

<AuthorizeView Roles="Admin">
    <Authorized>
        @if (_openMenu is not null)
        {
            <div class="menu-away" @onclick="() => _openMenu = null"></div>
        }

        <div class="layout">
            <div class="main-col">
                <section class="panel head-card">
                    <div class="panel-title">
                        <span class="ico"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" Color="Color.Inherit" /></span>
                        <div>
                            <h2>Inventory Overview</h2>
                            <p>Total stock, low stock alerts, and batch information.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-primary" @onclick="OpenAdd">
                        <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Inherit" /> Add Product
                    </button>
                </section>

                <div class="stats">
                    @foreach (var c in Cards)
                    {
                        <div class="stat">
                            <div class="stat-top">
                                <span class="stat-label">@c.Label</span>
                                <span class="ico sm @c.Tone"><MudIcon Icon="@c.Icon" Size="Size.Small" Color="Color.Inherit" /></span>
                            </div>
                            <div class="stat-value">@c.Value</div>
                            <div class="trend @c.TrendClass">@c.Trend</div>
                        </div>
                    }
                </div>

                <section class="panel">
                    <div class="filters">
                        <div class="search">
                            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Color="Color.Inherit" />
                            <input type="text" placeholder="Search product, batch number..." @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
                        </div>
                    </div>
                    <div class="filters">
                        <select @bind="_category" @bind:after="ResetPage">
                            <option value="">All Categories</option>
                            @foreach (var cat in InventoryItem.Categories) { <option value="@cat">@cat</option> }
                        </select>
                        <select @bind="_status" @bind:after="ResetPage">
                            <option value="">All Stock Status</option>
                            @foreach (var st in StatusList) { <option value="@st">@st</option> }
                        </select>
                        <select @bind="_supplier" @bind:after="ResetPage">
                            <option value="">All Suppliers</option>
                            @foreach (var sp in Suppliers) { <option value="@sp">@sp</option> }
                        </select>
                        <button type="button" class="chip @(_fifo ? "on" : "")" title="Show the oldest received batches first" @onclick="ToggleFifo">FIFO order</button>
                        <div class="view-toggle">
                            <button type="button" class="@(_view == "grid" ? "on" : "")" title="Grid view" @onclick='() => _view = "grid"'>
                                <MudIcon Icon="@Icons.Material.Outlined.GridView" Size="Size.Small" Color="Color.Inherit" />
                            </button>
                            <button type="button" class="@(_view == "list" ? "on" : "")" title="List view" @onclick='() => _view = "list"'>
                                <MudIcon Icon="@Icons.Material.Outlined.ViewList" Size="Size.Small" Color="Color.Inherit" />
                            </button>
                        </div>
                        @if (_selected.Count > 0)
                        {
                            <button type="button" class="btn-danger sm" @onclick="AskDeleteSelected">Delete selected (@_selected.Count)</button>
                        }
                    </div>

                    @if (_view == "list")
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th class="chk"><input type="checkbox" checked="@AllPageSelected" @onchange="TogglePage" /></th>
                                        <th>Product Name</th><th>Category</th><th>Batch #</th><th>Supplier</th>
                                        <th>Received Date</th><th>Expiry Date</th><th>Quantity</th><th>Status</th><th class="right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var it in PagedItems)
                                    {
                                        var st = Status(it);
                                        <tr>
                                            <td class="chk"><input type="checkbox" checked="@_selected.Contains(it.InventoryItemId)" @onchange="() => ToggleSelect(it.InventoryItemId)" /></td>
                                            <td>
                                                <div class="svc">
                                                    <span class="svc-ico @CatSlug(it.Category)"><MudIcon Icon="@CatIcon(it.Category)" Size="Size.Small" Color="Color.Inherit" /></span>
                                                    <div class="svc-text">
                                                        <div class="svc-name">@it.Name</div>
                                                        <div class="svc-desc">@it.Unit</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="pill cat-@CatSlug(it.Category)">@it.Category</span></td>
                                            <td class="muted">@it.BatchNumber</td>
                                            <td>@(it.Supplier ?? "—")</td>
                                            <td>@DateText(it.ReceivedDate)</td>
                                            <td>@DateText(it.ExpiryDate)</td>
                                            <td class="price">@it.Quantity pcs</td>
                                            <td><span class="pill st-@CatSlug(st)">@st</span></td>
                                            <td class="right actions">@RowActions(it)</td>
                                        </tr>
                                    }
                                    @if (!PagedItems.Any())
                                    {
                                        <tr><td colspan="10" class="empty">@EmptyText</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="cards">
                            @foreach (var it in PagedItems)
                            {
                                var st = Status(it);
                                <div class="svc-card">
                                    <div class="svc-card-top">
                                        <span class="svc-ico @CatSlug(it.Category)"><MudIcon Icon="@CatIcon(it.Category)" Size="Size.Small" Color="Color.Inherit" /></span>
                                        <span class="pill st-@CatSlug(st)">@st</span>
                                    </div>
                                    <div class="svc-name">@it.Name</div>
                                    <div class="svc-desc wrap">@it.Unit · Batch @it.BatchNumber</div>
                                    <div class="svc-meta">
                                        <span class="pill cat-@CatSlug(it.Category)">@it.Category</span>
                                        <span class="muted">@(it.Supplier ?? "—")</span>
                                    </div>
                                    <div class="svc-foot">
                                        <div>
                                            <div class="price">@it.Quantity pcs</div>
                                            <div class="muted">Exp: @DateText(it.ExpiryDate)</div>
                                        </div>
                                        <div class="actions">@RowActions(it)</div>
                                    </div>
                                </div>
                            }
                            @if (!PagedItems.Any())
                            {
                                <div class="empty full">@EmptyText</div>
                            }
                        </div>
                    }

                    <div class="table-foot">
                        <span>@ShowingText()</span>
                        @Pager()
                    </div>
                </section>
            </div>

            <aside class="side-col">
                <section class="panel side">
                    <div class="side-head">
                        <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.Notifications" Size="Size.Small" Color="Color.Inherit" /> Alerts</h3>
                        <button type="button" class="link" @onclick="ClearFilters">View All →</button>
                    </div>
                    @if (LowRows.Count == 0 && NearRows.Count == 0 && ExpiredRows.Count == 0)
                    {
                        <div class="empty left">No alerts. Stock levels and expiry dates look good.</div>
                    }
                    @if (LowRows.Count > 0)
                    {
                        <button type="button" class="notice red" @onclick='() => FilterStatus("Low Stock")'>
                            <span class="notice-ico"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" Color="Color.Inherit" /></span>
                            <span class="notice-body">
                                <b>Low Stock Alert</b>
                                <small>@LowText()</small>
                            </span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Inherit" />
                        </button>
                    }
                    @if (NearRows.Count > 0)
                    {
                        <button type="button" class="notice yellow" @onclick='() => FilterStatus("Expiring Soon")'>
                            <span class="notice-ico"><MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Color="Color.Inherit" /></span>
                            <span class="notice-body">
                                <b>Near Expiry / FIFO Alert</b>
                                <small>@ExpiryText(NearRows)</small>
                            </span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Inherit" />
                        </button>
                    }
                    @if (ExpiredRows.Count > 0)
                    {
                        <button type="button" class="notice blue" @onclick='() => FilterStatus("Expired")'>
                            <span class="notice-ico"><MudIcon Icon="@Icons.Material.Outlined.Block" Size="Size.Small" Color="Color.Inherit" /></span>
                            <span class="notice-body">
                                <b>Expired Product</b>
                                <small>@ExpiryText(ExpiredRows)</small>
                            </span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Inherit" />
                        </button>
                    }
                </section>

                <section class="panel side">
                    <div class="side-head">
                        <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" Color="Color.Inherit" /> Low Stock Items</h3>
                        <button type="button" class="link" @onclick='() => FilterStatus("Low Stock")'>View All →</button>
                    </div>
                    @foreach (var it in LowRows.Take(5))
                    {
                        <div class="low-row">
                            <span class="svc-ico sm @CatSlug(it.Category)"><MudIcon Icon="@CatIcon(it.Category)" Size="Size.Small" Color="Color.Inherit" /></span>
                            <span class="low-name">@it.Name</span>
                            <span class="low-qty">@it.Quantity pcs</span>
                        </div>
                    }
                    @if (LowRows.Count == 0)
                    {
                        <div class="empty left">Nothing is running low.</div>
                    }
                </section>

                <section class="panel side">
                    <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.Bolt" Size="Size.Small" Color="Color.Inherit" /> Quick Actions</h3>
                    <div class="qa-grid">
                        <button type="button" class="qa-tile" @onclick="OpenAdd">
                            <span class="qa-ico"><MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Inherit" /></span>
                            Add Product
                        </button>
                        <button type="button" class="qa-tile" @onclick="() => OpenStock(null)">
                            <span class="qa-ico"><MudIcon Icon="@Icons.Material.Outlined.Autorenew" Size="Size.Small" Color="Color.Inherit" /></span>
                            Update Stock
                        </button>
                        <button type="button" class="qa-tile" @onclick="ViewBatches">
                            <span class="qa-ico"><MudIcon Icon="@Icons.Material.Outlined.ListAlt" Size="Size.Small" Color="Color.Inherit" /></span>
                            View Batches
                        </button>
                        <button type="button" class="qa-tile" @onclick="OpenReport">
                            <span class="qa-ico"><MudIcon Icon="@Icons.Material.Outlined.Assessment" Size="Size.Small" Color="Color.Inherit" /></span>
                            Generate Report
                        </button>
                    </div>
                </section>
            </aside>
        </div>

        @if (_message is not null)
        {
            <div class="toast" @onclick="() => _message = null">@_message</div>
        }

        @if (_modal != ModalKind.None)
        {
            <div class="overlay" @onclick="CloseModal">
                <div class="modal @(_modal == ModalKind.Item || _modal == ModalKind.Report ? "wide" : "")" @onclick:stopPropagation="true">
                    @switch (_modal)
                    {
                        case ModalKind.Item:
                            <h3>@(_editing ? "Edit Product Batch" : "Add Product")</h3>
                            <div class="row2">
                                <label>Product name<input type="text" @bind="_form.Name" /></label>
                                <label>Size / pack (optional)<input type="text" placeholder="e.g. 2kg" @bind="_form.Unit" /></label>
                            </div>
                            <div class="row2">
                                <label>Category
                                    <select @bind="_form.Category">
                                        @foreach (var cat in InventoryItem.Categories) { <option value="@cat">@cat</option> }
                                    </select>
                                </label>
                                <label>Supplier<input type="text" @bind="_form.Supplier" /></label>
                            </div>
                            <div class="row2">
                                <label>Batch number<input type="text" placeholder="Leave blank to auto-generate" @bind="_form.Batch" /></label>
                                <label>Unit price (₱)<input type="number" min="0" step="0.01" @bind="_form.Price" /></label>
                            </div>
                            <div class="row2">
                                <label>Received date<input type="date" @bind="_form.Received" /></label>
                                <label>Expiry date (optional)<input type="date" @bind="_form.Expiry" /></label>
                            </div>
                            <div class="row2">
                                <label>Quantity<input type="number" min="0" @bind="_form.Qty" /></label>
                                <label>Low stock level<input type="number" min="0" @bind="_form.Reorder" /></label>
                            </div>
                            break;
                        case ModalKind.Stock:
                            <h3>Update Stock</h3>
                            <label>Action
                                <select @bind="_stockMode">
                                    <option value="fifo">Use stock (FIFO – oldest batch first)</option>
                                    <option value="add">Add stock to a batch</option>
                                    <option value="set">Set a batch's quantity</option>
                                </select>
                            </label>
                            @if (_stockMode == "fifo")
                            {
                                <label>Product
                                    <select @bind="_stockProduct">
                                        <option value="">Select a product…</option>
                                        @foreach (var p in ProductNames) { <option value="@p">@p</option> }
                                    </select>
                                </label>
                                @if (_stockProduct != "")
                                {
                                    <span class="hint">@FifoPreview()</span>
                                }
                            }
                            else
                            {
                                <label>Batch
                                    <select @bind="_stockBatchId">
                                        <option value="0">Select a batch…</option>
                                        @foreach (var b in _items) { <option value="@b.InventoryItemId">@b.Name — @b.BatchNumber (@b.Quantity pcs)</option> }
                                    </select>
                                </label>
                            }
                            <label>@(_stockMode == "set" ? "New quantity" : "Quantity")<input type="number" min="0" @bind="_stockQty" /></label>
                            break;
                        case ModalKind.Report:
                            <h3>Inventory Report</h3>
                            <div class="report">
                                @foreach (var line in ReportLines())
                                {
                                    <div class="report-row @(line.Head ? "head" : "")"><span>@line.Label</span><span>@line.Value</span></div>
                                }
                            </div>
                            break;
                        case ModalKind.Confirm:
                            <h3>Confirm delete</h3>
                            <p class="confirm-text">@_confirmText</p>
                            break;
                    }

                    @if (_error is not null)
                    {
                        <div class="form-error">@_error</div>
                    }

                    <div class="modal-actions">
                        <button type="button" class="btn-ghost" @onclick="CloseModal">@(_modal == ModalKind.Report ? "Close" : "Cancel")</button>
                        @if (_modal == ModalKind.Confirm)
                        {
                            <button type="button" class="btn-danger" @onclick="ConfirmDelete">Delete</button>
                        }
                        else if (_modal == ModalKind.Report)
                        {
                            <button type="button" class="btn-primary" @onclick="CopyReport">Copy report</button>
                        }
                        else
                        {
                            <button type="button" class="btn-primary" @onclick="SaveModal">Save</button>
                        }
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">This page is for administrators only. Please log in with an admin account.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const int PageSize = 10;
    private enum ModalKind { None, Item, Stock, Report, Confirm }
    private record StatCard(string Label, string Value, string Icon, string Tone, string Trend, string TrendClass);
    private record ReportLine(string Label, string Value, bool Head = false);
    private static readonly string[] StatusList = { "In Stock", "Low Stock", "Out of Stock", "Expiring Soon", "Expired" };

    private class ItemForm
    {
        public int Id;
        public string Name = "", Unit = "", Category = "Pet Food", Supplier = "", Batch = "";
        public DateOnly? Received, Expiry;
        public int Qty, Reorder = 10;
        public decimal Price;
    }

    private List<InventoryItem> _items = new();
    private DateOnly _today = InventoryService.Today;
    private string _actor = "Admin";

    private string _search = "", _category = "", _status = "", _supplier = "", _view = "list";
    private bool _fifo;
    private int _pageNo = 1;
    private readonly HashSet<int> _selected = new();

    private string? _openMenu, _message, _error, _confirmText;
    private ModalKind _modal = ModalKind.None;
    private ItemForm _form = new();
    private bool _editing;
    private Func<Task>? _confirmAction;

    private string _stockMode = "fifo", _stockProduct = "";
    private int _stockBatchId, _stockQty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole("Admin")) return;
        _actor = state.User.Identity?.Name ?? "Admin";
        await Reload();
    }

    private async Task Reload()
    {
        _today = InventoryService.Today;
        _items = await InventorySvc.LoadAsync();
        _selected.RemoveWhere(id => _items.All(i => i.InventoryItemId != id));
    }

    // ---------- derived data (all computed from the database rows) ----------
    private string Status(InventoryItem i) => InventoryService.StatusOf(i, _today);

    private List<InventoryItem> LowRows => _items
        .Where(i => i.Quantity <= i.ReorderLevel && !(i.ExpiryDate is { } e && e < _today))
        .OrderBy(i => i.Quantity).ThenBy(i => i.Name).ToList();

    private List<InventoryItem> NearRows => _items
        .Where(i => i.Quantity > 0 && i.ExpiryDate is { } e && e >= _today && e <= _today.AddDays(InventoryService.NearExpiryDays))
        .OrderBy(i => i.ExpiryDate).ToList();

    private List<InventoryItem> ExpiredRows => _items
        .Where(i => i.Quantity > 0 && i.ExpiryDate is { } e && e < _today)
        .OrderBy(i => i.ExpiryDate).ToList();

    private IEnumerable<string> Suppliers => _items.Select(i => i.Supplier).Where(s => !string.IsNullOrWhiteSpace(s))
        .Select(s => s!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> ProductNames => _items.Select(i => i.Name).Distinct().OrderBy(n => n);

    private IEnumerable<StatCard> Cards
    {
        get
        {
            var monthStart = new DateOnly(_today.Year, _today.Month, 1);
            var newBatches = _items.Where(i => i.ReceivedDate >= monthStart).ToList();

            yield return new StatCard("Total Products", _items.Select(i => i.Name).Distinct().Count().ToString("N0"),
                Icons.Material.Outlined.Inventory2, "",
                newBatches.Count > 0 ? $"↑ {newBatches.Count} batch{(newBatches.Count == 1 ? "" : "es")} received this month" : "No new batches this month",
                newBatches.Count > 0 ? "up" : "na");

            var received = newBatches.Sum(i => i.Quantity);
            yield return new StatCard("Total Stock Quantity", _items.Sum(i => i.Quantity).ToString("N0"),
                Icons.Material.Outlined.ListAlt, "blue",
                received > 0 ? $"↑ {received:N0} pcs received this month" : "No stock received this month",
                received > 0 ? "up" : "na");

            var low = LowRows;
            var out0 = low.Count(i => i.Quantity <= 0);
            yield return new StatCard("Low Stock Items", low.Count.ToString("N0"),
                Icons.Material.Outlined.WarningAmber, "red",
                low.Count == 0 ? "All items are stocked" : out0 > 0 ? $"{out0} out of stock" : "Needs restocking",
                low.Count == 0 ? "up" : "down");

            var exp = ExpiredRows.Count;
            var near = NearRows.Count;
            yield return new StatCard("Expired / Near Expiry", (exp + near).ToString("N0"),
                Icons.Material.Outlined.Schedule, "purple",
                exp + near == 0 ? "Nothing expiring soon" : $"{exp} expired · {near} expiring soon",
                exp > 0 ? "down" : "na");
        }
    }

    // ---------- filtering / paging ----------
    private IEnumerable<InventoryItem> Filtered
    {
        get
        {
            var q = _items.Where(i =>
                (_category == "" || i.Category == _category) &&
                (_supplier == "" || string.Equals(i.Supplier, _supplier, StringComparison.OrdinalIgnoreCase)) &&
                (_status == "" || MatchesStatus(i, _status)) &&
                (string.IsNullOrWhiteSpace(_search) ||
                    i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    i.BatchNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (i.Supplier ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)));

            return _fifo
                ? q.OrderBy(i => i.ReceivedDate ?? DateOnly.MaxValue).ThenBy(i => i.ExpiryDate ?? DateOnly.MaxValue).ThenBy(i => i.Name)
                : q;
        }
    }

    private bool MatchesStatus(InventoryItem i, string status) => status switch
    {
        "Expiring Soon" => NearRows.Contains(i),
        "Expired" => i.ExpiryDate is { } e && e < _today,
        "Low Stock" => LowRows.Contains(i),
        _ => Status(i) == status
    };

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count() / (double)PageSize));
    private int CurrentPage => Math.Min(_pageNo, PageCount);
    private IEnumerable<InventoryItem> PagedItems => Filtered.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private string EmptyText => _items.Count == 0
        ? "No inventory yet. Click Add Product to record your first batch."
        : "No batches match your filters.";

    private string ShowingText()
    {
        var total = Filtered.Count();
        if (total == 0) return "Showing 0 of 0 batches";
        var from = (CurrentPage - 1) * PageSize + 1;
        var to = Math.Min(CurrentPage * PageSize, total);
        return $"Showing {from}–{to} of {total} batches";
    }

    private void ResetPage() => _pageNo = 1;

    private void ClearFilters()
    {
        _search = _category = _status = _supplier = "";
        _pageNo = 1;
    }

    private void FilterStatus(string status)
    {
        ClearFilters();
        _status = status;
    }

    private void ToggleFifo()
    {
        _fifo = !_fifo;
        _pageNo = 1;
    }

    private void ViewBatches()
    {
        ClearFilters();
        _fifo = true;
        _view = "list";
        Flash("Showing batches oldest-received first (FIFO).");
    }

    private bool AllPageSelected => PagedItems.Any() && PagedItems.All(i => _selected.Contains(i.InventoryItemId));

    private void TogglePage()
    {
        var ids = PagedItems.Select(i => i.InventoryItemId).ToList();
        if (AllPageSelected) foreach (var id in ids) _selected.Remove(id);
        else foreach (var id in ids) _selected.Add(id);
    }

    private void ToggleSelect(int id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
    }

    private RenderFragment Pager() => __builder =>
    {
        var cur = CurrentPage;
        var pages = PageCount;
        var start = Math.Max(1, Math.Min(cur - 2, pages - 4));
        var end = Math.Min(pages, start + 4);
        <div class="pager">
            <button type="button" disabled="@(cur <= 1)" @onclick="() => _pageNo = cur - 1">‹</button>
            @for (var n = start; n <= end; n++)
            {
                var pg = n;
                <button type="button" class="@(pg == cur ? "on" : "")" @onclick="() => _pageNo = pg">@pg</button>
            }
            <button type="button" disabled="@(cur >= pages)" @onclick="() => _pageNo = cur + 1">›</button>
        </div>
    };

    private RenderFragment RowActions(InventoryItem it) => __builder =>
    {
        <button type="button" class="icon-btn" title="Edit" @onclick="() => OpenEdit(it)">
            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Inherit" />
        </button>
        <span class="menu-host">
            <button type="button" class="icon-btn" title="More" @onclick="() => ToggleMenu(ItemKey(it))">
                <MudIcon Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Color="Color.Inherit" />
            </button>
            @if (_openMenu == ItemKey(it))
            {
                <div class="menu">
                    <button type="button" @onclick="() => OpenStock(it)">Update stock</button>
                    <button type="button" class="danger" @onclick="() => AskDelete(it)">Delete</button>
                </div>
            }
        </span>
    };

    // ---------- small helpers ----------
    private static string DateText(DateOnly? d) => d is null ? "—" : d.Value.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private static string More(string text, int total) => total > 3 ? $"{text} +{total - 3} more" : text;

    private string LowText() =>
        More(string.Join(", ", LowRows.Take(3).Select(i => $"{i.Name} ({i.Quantity} pcs)")), LowRows.Count);

    private static string ExpiryText(List<InventoryItem> rows) =>
        More(string.Join(", ", rows.Take(3).Select(i => $"{i.Name} (Exp: {DateText(i.ExpiryDate)}) – {i.Quantity} pcs")), rows.Count);

    private static string CatSlug(string c) => new string(c.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();

    private static string CatIcon(string c) => c switch
    {
        "Pet Food" => Icons.Material.Outlined.Fastfood,
        "Grooming" => Icons.Material.Outlined.ContentCut,
        "Accessories" => Icons.Material.Outlined.Sell,
        "Supplies" => Icons.Material.Outlined.Inventory2,
        "Health" => Icons.Material.Outlined.HealthAndSafety,
        "Toys" => Icons.Material.Outlined.Toys,
        "Treats" => Icons.Material.Outlined.Cookie,
        _ => Icons.Material.Outlined.Pets
    };

    private static string ItemKey(InventoryItem i) => "i:" + i.InventoryItemId;

    private void ToggleMenu(string key) => _openMenu = _openMenu == key ? null : key;

    private void Flash(string text) => _message = text;

    private void CloseModal()
    {
        _modal = ModalKind.None;
        _error = null;
        _confirmAction = null;
    }

    private async Task SaveModal()
    {
        _error = null;
        if (_modal == ModalKind.Item) await SaveItem();
        else if (_modal == ModalKind.Stock) await SaveStock();
    }

    private async Task ConfirmDelete()
    {
        if (_confirmAction is not null) await _confirmAction();
        CloseModal();
    }

    // ---------- add / edit ----------
    private void OpenAdd()
    {
        _form = new ItemForm { Received = _today };
        _editing = false;
        _error = null;
        _modal = ModalKind.Item;
    }

    private void OpenEdit(InventoryItem i)
    {
        _openMenu = null;
        _form = new ItemForm
        {
            Id = i.InventoryItemId,
            Name = i.Name,
            Unit = i.Unit ?? "",
            Category = i.Category,
            Supplier = i.Supplier ?? "",
            Batch = i.BatchNumber,
            Received = i.ReceivedDate,
            Expiry = i.ExpiryDate,
            Qty = i.Quantity,
            Reorder = i.ReorderLevel,
            Price = i.UnitPrice
        };
        _editing = true;
        _error = null;
        _modal = ModalKind.Item;
    }

    private async Task SaveItem()
    {
        var name = _form.Name.Trim();
        if (name == "") { _error = "Product name is required."; return; }
        if (_form.Qty < 0) { _error = "Quantity can't be negative."; return; }
        if (_form.Reorder < 0) { _error = "Low stock level can't be negative."; return; }
        if (_form.Price < 0) { _error = "Unit price can't be negative."; return; }
        if (_form.Received is { } r && _form.Expiry is { } x && x < r)
        { _error = "Expiry date can't be before the received date."; return; }

        var item = new InventoryItem
        {
            InventoryItemId = _form.Id,
            Name = name,
            Unit = string.IsNullOrWhiteSpace(_form.Unit) ? null : _form.Unit.Trim(),
            Category = _form.Category,
            Supplier = string.IsNullOrWhiteSpace(_form.Supplier) ? null : _form.Supplier.Trim(),
            BatchNumber = _form.Batch.Trim(),
            ReceivedDate = _form.Received,
            ExpiryDate = _form.Expiry,
            Quantity = _form.Qty,
            ReorderLevel = _form.Reorder,
            UnitPrice = _form.Price
        };

        var err = _editing
            ? await InventorySvc.UpdateAsync(item, _actor)
            : await InventorySvc.AddAsync(item, _actor);
        if (err is not null) { _error = err; return; }

        var wasEditing = _editing;
        CloseModal();
        await Reload();
        Flash(wasEditing ? "Product batch updated." : "Product added.");
    }

    // ---------- delete ----------
    private void AskDelete(InventoryItem i)
    {
        _openMenu = null;
        _confirmText = $"Delete {i.Name} (batch {i.BatchNumber})? This can't be undone.";
        _confirmAction = async () =>
        {
            await InventorySvc.DeleteAsync(new[] { i.InventoryItemId }, _actor);
            await Reload();
            Flash("Batch deleted.");
        };
        _error = null;
        _modal = ModalKind.Confirm;
    }

    private void AskDeleteSelected()
    {
        var ids = _selected.ToList();
        _confirmText = $"Delete {ids.Count} selected batch{(ids.Count == 1 ? "" : "es")}? This can't be undone.";
        _confirmAction = async () =>
        {
            await InventorySvc.DeleteAsync(ids, _actor);
            _selected.Clear();
            await Reload();
            Flash("Selected batches deleted.");
        };
        _error = null;
        _modal = ModalKind.Confirm;
    }

    // ---------- update stock (FIFO / add / set) ----------
    private void OpenStock(InventoryItem? it)
    {
        _openMenu = null;
        _stockMode = it is null ? "fifo" : "add";
        _stockProduct = it?.Name ?? "";
        _stockBatchId = it?.InventoryItemId ?? 0;
        _stockQty = 0;
        _error = null;
        _modal = ModalKind.Stock;
    }

    private string FifoPreview()
    {
        var order = _items
            .Where(i => i.Name == _stockProduct && i.Quantity > 0 && !(i.ExpiryDate is { } e && e < _today))
            .OrderBy(i => i.ReceivedDate ?? DateOnly.MinValue).ThenBy(i => i.ExpiryDate ?? DateOnly.MaxValue)
            .ToList();
        if (order.Count == 0) return "No usable stock for this product.";
        return "Will be taken from: " + string.Join(" → ", order.Select(i => $"{i.BatchNumber} ({i.Quantity} pcs)"));
    }

    private async Task SaveStock()
    {
        string? err;
        if (_stockMode == "fifo")
        {
            if (_stockProduct == "") { _error = "Choose a product."; return; }
            err = await InventorySvc.StockOutFifoAsync(_stockProduct, _stockQty, _actor);
        }
        else
        {
            if (_stockBatchId == 0) { _error = "Choose a batch."; return; }
            if (_stockQty < 0 || (_stockMode == "add" && _stockQty == 0)) { _error = "Enter a quantity above zero."; return; }
            err = await InventorySvc.AdjustBatchAsync(_stockBatchId, _stockQty, _stockMode == "set", _actor);
        }
        if (err is not null) { _error = err; return; }

        CloseModal();
        await Reload();
        Flash("Stock updated.");
    }

    // ---------- report ----------
    private void OpenReport()
    {
        _error = null;
        _modal = ModalKind.Report;
    }

    private List<ReportLine> ReportLines()
    {
        var lines = new List<ReportLine>
        {
            new("Inventory report — " + DateText(_today), "", true),
            new("Products", _items.Select(i => i.Name).Distinct().Count().ToString("N0")),
            new("Batches", _items.Count.ToString("N0")),
            new("Total stock (pcs)", _items.Sum(i => i.Quantity).ToString("N0")),
            new("Stock value", "₱" + _items.Sum(i => i.Quantity * i.UnitPrice).ToString("N2", System.Globalization.CultureInfo.InvariantCulture)),
            new("Low stock batches", LowRows.Count.ToString("N0")),
            new("Expiring within 30 days", NearRows.Count.ToString("N0")),
            new("Expired (still in stock)", ExpiredRows.Count.ToString("N0")),
            new("By category", "", true)
        };
        foreach (var g in _items.GroupBy(i => i.Category).OrderBy(g => g.Key))
            lines.Add(new(g.Key, $"{g.Sum(i => i.Quantity):N0} pcs"));
        return lines;
    }

    private async Task CopyReport()
    {
        var text = string.Join("\n", ReportLines().Select(l => l.Value == "" ? l.Label : $"{l.Label}: {l.Value}"));
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Flash("Report copied to clipboard.");
        }
        catch
        {
            _error = "Couldn't copy automatically. Select the text and copy it instead.";
            return;
        }
        CloseModal();
    }
}
