@page "/admin/services"
@layout AdminLayout
@using Pawfect.Services
@inject CatalogService CatalogSvc
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Service Catalog - Pawfect Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Service Catalog Management</h1>
        <p>Manage grooming services and pricing</p>
    </div>
    <AdminTopTools />
</div>

<AuthorizeView Roles="Admin">
    <Authorized>
        @if (_openMenu is not null)
        {
            <div class="menu-away" @onclick="() => _openMenu = null"></div>
        }

        <div class="layout">
            <div class="main-col">
                <section class="panel head-card">
                    <div class="panel-title">
                        <span class="ico"><MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Color="Color.Inherit" /></span>
                        <div>
                            <h2>Service Catalog</h2>
                            <p>View, add, edit, and manage grooming services, pricing, and time slots.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-primary" @onclick="OpenAdd">
                        <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Inherit" /> Add Service
                    </button>
                </section>

                <div class="stats">
                    @foreach (var c in Cards)
                    {
                        <div class="stat">
                            <div class="stat-top">
                                <span class="stat-label">@c.Label</span>
                                <span class="ico sm"><MudIcon Icon="@c.Icon" Size="Size.Small" Color="Color.Inherit" /></span>
                            </div>
                            <div class="stat-value">@c.Value</div>
                            <div class="trend @c.TrendClass">@c.Trend</div>
                        </div>
                    }
                </div>

                <section class="panel">
                    <div class="filters">
                        <div class="search">
                            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Color="Color.Inherit" />
                            <input type="text" placeholder="Search services..." @bind="_search" @bind:event="oninput" @bind:after="() => _pageNo = 1" />
                        </div>
                    </div>
                    <div class="filters">
                        <select @bind="_category" @bind:after="() => _pageNo = 1">
                            <option value="">All Categories</option>
                            @foreach (var cat in ServiceItem.Categories) { <option value="@cat">@cat</option> }
                        </select>
                        <select @bind="_size" @bind:after="() => _pageNo = 1">
                            <option value="">All Sizes</option>
                            @foreach (var sz in ServiceItem.Sizes) { <option value="@sz">@sz</option> }
                        </select>
                        <select @bind="_status" @bind:after="() => _pageNo = 1">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <div class="view-toggle">
                            <button type="button" class="@(_view == "grid" ? "on" : "")" title="Grid view" @onclick='() => _view = "grid"'>
                                <MudIcon Icon="@Icons.Material.Outlined.GridView" Size="Size.Small" Color="Color.Inherit" />
                            </button>
                            <button type="button" class="@(_view == "list" ? "on" : "")" title="List view" @onclick='() => _view = "list"'>
                                <MudIcon Icon="@Icons.Material.Outlined.ViewList" Size="Size.Small" Color="Color.Inherit" />
                            </button>
                        </div>
                    </div>

                    @if (_view == "list")
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr><th>Service</th><th>Category</th><th>Size / Type</th><th>Duration</th><th>Price</th><th>Status</th><th class="right">Actions</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var sv in PagedItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="svc">
                                                    <span class="svc-ico"><MudIcon Icon="@CatIcon(sv.Category)" Size="Size.Small" Color="Color.Inherit" /></span>
                                                    <div class="svc-text">
                                                        <div class="svc-name">@sv.Name</div>
                                                        <div class="svc-desc">@sv.Description</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="pill cat-@CatSlug(sv.Category)">@sv.Category</span></td>
                                            <td class="muted">@sv.SizeText</td>
                                            <td>@sv.DurationMinutes mins</td>
                                            <td class="price">@PriceText(sv)</td>
                                            <td><span class="pill @(sv.IsActive ? "active" : "inactive")">@(sv.IsActive ? "Active" : "Inactive")</span></td>
                                            <td class="right actions">@RowActions(sv)</td>
                                        </tr>
                                    }
                                    @if (!PagedItems.Any())
                                    {
                                        <tr><td colspan="7" class="empty">@EmptyText</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="cards">
                            @foreach (var sv in PagedItems)
                            {
                                <div class="svc-card">
                                    <div class="svc-card-top">
                                        <span class="svc-ico"><MudIcon Icon="@CatIcon(sv.Category)" Size="Size.Small" Color="Color.Inherit" /></span>
                                        <span class="pill @(sv.IsActive ? "active" : "inactive")">@(sv.IsActive ? "Active" : "Inactive")</span>
                                    </div>
                                    <div class="svc-name">@sv.Name</div>
                                    <div class="svc-desc wrap">@sv.Description</div>
                                    <div class="svc-meta">
                                        <span class="pill cat-@CatSlug(sv.Category)">@sv.Category</span>
                                        <span class="muted">@sv.SizeText</span>
                                    </div>
                                    <div class="svc-foot">
                                        <div>
                                            <div class="price">@PriceText(sv)</div>
                                            <div class="muted">@sv.DurationMinutes mins</div>
                                        </div>
                                        <div class="actions">@RowActions(sv)</div>
                                    </div>
                                </div>
                            }
                            @if (!PagedItems.Any())
                            {
                                <div class="empty full">@EmptyText</div>
                            }
                        </div>
                    }

                    <div class="table-foot">
                        <span>@ShowingText()</span>
                        @Pager()
                    </div>
                </section>
            </div>

            <aside class="side-col">
                <section class="panel side">
                    <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.Sell" Size="Size.Small" Color="Color.Inherit" /> SERVICE CATEGORIES</h3>
                    @foreach (var cat in ServiceItem.Categories)
                    {
                        <div class="cat-row">
                            <span class="dot cat-@CatSlug(cat)"></span>
                            <span class="cat-name">@cat</span>
                            <span class="cat-count">@_items.Count(i => i.Category == cat)</span>
                        </div>
                    }
                </section>

                <section class="panel side">
                    <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.StarBorder" Size="Size.Small" Color="Color.Inherit" /> POPULAR SERVICES</h3>
                    @foreach (var pop in Popular)
                    {
                        <div class="pop-row">
                            <span class="svc-ico sm"><MudIcon Icon="@CatIcon(pop.Item.Category)" Size="Size.Small" Color="Color.Inherit" /></span>
                            <span class="pop-name">@pop.Item.Name</span>
                            <span class="pop-count">@pop.Count @(pop.Count == 1 ? "booking" : "bookings")</span>
                        </div>
                    }
                    @if (!Popular.Any())
                    {
                        <div class="empty left">No bookings for these services yet.</div>
                    }
                </section>

                <section class="panel side">
                    <h3 class="side-title"><MudIcon Icon="@Icons.Material.Outlined.Bolt" Size="Size.Small" Color="Color.Inherit" /> QUICK ACTIONS</h3>
                    <button type="button" class="qa" @onclick="OpenAdd">
                        <span class="qa-ico"><MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Inherit" /></span>
                        <span><b>Add New Service</b><small>Create a new service listing</small></span>
                    </button>
                    <button type="button" class="qa" @onclick="OpenPricing">
                        <span class="qa-ico"><MudIcon Icon="@Icons.Material.Outlined.Sell" Size="Size.Small" Color="Color.Inherit" /></span>
                        <span><b>Manage Pricing</b><small>Update service rates</small></span>
                    </button>
                    <button type="button" class="qa" @onclick="OpenDurations">
                        <span class="qa-ico"><MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" Color="Color.Inherit" /></span>
                        <span><b>Set Time Slots</b><small>Configure service durations</small></span>
                    </button>
                </section>
            </aside>
        </div>

        @if (_message is not null)
        {
            <div class="toast" @onclick="() => _message = null">@_message</div>
        }

        @if (_modal != ModalKind.None)
        {
            <div class="overlay" @onclick="CloseModal">
                <div class="modal @(_modal == ModalKind.Pricing || _modal == ModalKind.Duration ? "wide" : "")" @onclick:stopPropagation="true">
                    @switch (_modal)
                    {
                        case ModalKind.Service:
                            <h3>@(_editing ? "Edit Service" : "Add Service")</h3>
                            <label>Service name<input type="text" @bind="_form.Name" /></label>
                            <label>Description<textarea rows="2" @bind="_form.Description"></textarea></label>
                            <label>Category
                                <select @bind="_form.Category">
                                    @foreach (var cat in ServiceItem.Categories) { <option value="@cat">@cat</option> }
                                </select>
                            </label>
                            <div class="field">
                                <span class="field-label">Sizes</span>
                                <div class="sizes">
                                    @foreach (var sz in ServiceItem.Sizes)
                                    {
                                        <label class="check"><input type="checkbox" checked="@_form.Sizes.Contains(sz)" @onchange="() => ToggleSize(sz)" /> @sz</label>
                                    }
                                </div>
                                <span class="hint">Leave all unchecked for All Sizes.</span>
                            </div>
                            <div class="row3">
                                <label>Duration (mins)<input type="number" min="1" @bind="_form.Duration" /></label>
                                <label>Min price (₱)<input type="number" min="0" step="0.01" @bind="_form.Min" /></label>
                                <label>Max price (₱)<input type="number" min="0" step="0.01" @bind="_form.Max" /></label>
                            </div>
                            <label class="check"><input type="checkbox" @bind="_form.Active" /> Active</label>
                            break;
                        case ModalKind.Pricing:
                            <div class="fields">
                            <h3>Manage Pricing</h3>
                            @if (_bulk.Count == 0)
                            {
                                <p class="confirm-text">There are no services yet. Add a service first.</p>
                            }
                            else
                            {
                                <div class="bulk">
                                    <div class="bulk-row head"><span>Service</span><span>Min (₱)</span><span>Max (₱)</span></div>
                                    @foreach (var b in _bulk)
                                    {
                                        <div class="bulk-row">
                                            <span class="bulk-name">@b.Name</span>
                                            <input type="number" min="0" step="0.01" @bind="b.Min" />
                                            <input type="number" min="0" step="0.01" @bind="b.Max" />
                                        </div>
                                    }
                                </div>
                            }
                            </div>
                            break;
                        case ModalKind.Duration:
                            <div class="fields">
                            <h3>Set Time Slots</h3>
                            @if (_bulk.Count == 0)
                            {
                                <p class="confirm-text">There are no services yet. Add a service first.</p>
                            }
                            else
                            {
                                <div class="bulk">
                                    <div class="bulk-row two head"><span>Service</span><span>Duration (mins)</span></div>
                                    @foreach (var b in _bulk)
                                    {
                                        <div class="bulk-row two">
                                            <span class="bulk-name">@b.Name</span>
                                            <input type="number" min="1" @bind="b.Minutes" />
                                        </div>
                                    }
                                </div>
                            }
                            </div>
                            break;
                        case ModalKind.Confirm:
                            <h3>Confirm delete</h3>
                            <p class="confirm-text">@_confirmText</p>
                            break;
                    }

                    @if (_error is not null)
                    {
                        <div class="form-error">@_error</div>
                    }

                    <div class="modal-actions">
                        <button type="button" class="btn-ghost" @onclick="CloseModal">Cancel</button>
                        @if (_modal == ModalKind.Confirm)
                        {
                            <button type="button" class="btn-danger" @onclick="ConfirmDelete">Delete</button>
                        }
                        else if (_modal == ModalKind.Service || _bulk.Count > 0)
                        {
                            <button type="button" class="btn-primary" @onclick="SaveModal">Save</button>
                        }
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">This page is for administrators only. Please log in with an admin account.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const int PageSize = 5;
    private enum ModalKind { None, Service, Pricing, Duration, Confirm }
    private record StatCard(string Label, string Value, string Icon, string Trend, string TrendClass);
    private record PopItem(ServiceItem Item, int Count);

    private class ServiceForm
    {
        public int Id;
        public string Name = "", Description = "", Category = "Grooming";
        public int Duration = 30;
        public decimal Min, Max;
        public bool Active = true;
        public HashSet<string> Sizes = new();
    }

    private class BulkRow
    {
        public int Id;
        public string Name = "";
        public decimal Min, Max;
        public int Minutes;
    }

    private List<ServiceItem> _items = new();
    private BookingInfo _book = new(new Dictionary<string, int>(), 0, 0, 0);
    private string _actor = "Admin";

    private string _search = "", _category = "", _size = "", _status = "", _view = "list";
    private int _pageNo = 1;

    private string? _openMenu, _message, _error, _confirmText;
    private ModalKind _modal = ModalKind.None;
    private ServiceForm _form = new();
    private bool _editing;
    private List<BulkRow> _bulk = new();
    private Func<Task>? _confirmAction;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole("Admin")) return;
        _actor = state.User.Identity?.Name ?? "Admin";
        await Reload();
    }

    private async Task Reload()
    {
        _items = await CatalogSvc.LoadAsync();
        _book = await CatalogSvc.LoadBookingsAsync(_items.Select(i => i.Name).ToList());
    }

    // ---------- filtering / paging ----------
    private IEnumerable<ServiceItem> Filtered => _items.Where(i =>
        (_category == "" || i.Category == _category) &&
        (_size == "" || i.SizeList.Length == 0 || i.SizeList.Contains(_size)) &&
        (_status == "" || (_status == "Active") == i.IsActive) &&
        (string.IsNullOrWhiteSpace(_search) ||
            i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            (i.Description ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count() / (double)PageSize));
    private int CurrentPage => Math.Min(_pageNo, PageCount);

    private IEnumerable<ServiceItem> PagedItems =>
        Filtered.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private string EmptyText => _items.Count == 0
        ? "No services yet. Click Add Service to create one."
        : "No services match your filters.";

    private string ShowingText()
    {
        var total = Filtered.Count();
        if (total == 0) return "Showing 0 of 0 services";
        var from = (CurrentPage - 1) * PageSize + 1;
        var to = Math.Min(CurrentPage * PageSize, total);
        return $"Showing {from}–{to} of {total} services";
    }

    private RenderFragment Pager() => __builder =>
    {
        var cur = CurrentPage;
        var pages = PageCount;
        var start = Math.Max(1, Math.Min(cur - 2, pages - 4));
        var end = Math.Min(pages, start + 4);
        <div class="pager">
            <button type="button" disabled="@(cur <= 1)" @onclick="() => _pageNo = cur - 1">‹</button>
            @for (var n = start; n <= end; n++)
            {
                var pg = n;
                <button type="button" class="@(pg == cur ? "on" : "")" @onclick="() => _pageNo = pg">@pg</button>
            }
            <button type="button" disabled="@(cur >= pages)" @onclick="() => _pageNo = cur + 1">›</button>
        </div>
    };

    private RenderFragment RowActions(ServiceItem sv) => __builder =>
    {
        <button type="button" class="icon-btn" title="Edit" @onclick="() => OpenEdit(sv)">
            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Inherit" />
        </button>
        <span class="menu-host">
            <button type="button" class="icon-btn" title="More" @onclick="() => ToggleMenu(ItemKey(sv))">
                <MudIcon Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Color="Color.Inherit" />
            </button>
            @if (_openMenu == ItemKey(sv))
            {
                <div class="menu">
                    <button type="button" @onclick="() => ToggleItem(sv)">@(sv.IsActive ? "Deactivate" : "Activate")</button>
                    <button type="button" class="danger" @onclick="() => AskDelete(sv)">Delete</button>
                </div>
            }
        </span>
    };

    // ---------- stat cards and sidebar data (all computed from the database) ----------
    private IEnumerable<StatCard> Cards
    {
        get
        {
            var local = DateTime.UtcNow.AddHours(8);
            var monthStart = DateTime.SpecifyKind(new DateTime(local.Year, local.Month, 1).AddHours(-8), DateTimeKind.Utc);
            var newThis = _items.Count(i => i.DateCreated >= monthStart);

            yield return new StatCard("Total Services", _items.Count.ToString("N0"), Icons.Material.Outlined.Pets,
                newThis > 0 ? $"↑ {newThis} new this month" : "No new services this month", newThis > 0 ? "up" : "na");

            yield return new StatCard("Avg. Price", _items.Count == 0 ? "—" : Peso(_items.Average(i => i.Midpoint)),
                Icons.Material.Outlined.Sell, "N/A vs. last month", "na");

            yield return new StatCard("Avg. Duration", _items.Count == 0 ? "—" : $"{_items.Average(i => i.DurationMinutes):0} mins",
                Icons.Material.Outlined.Schedule, "N/A vs. last month", "na");

            string text = "N/A vs. last month", cls = "na";
            if (_book.LastMonth > 0)
            {
                var pct = (_book.ThisMonth - _book.LastMonth) * 100.0 / _book.LastMonth;
                cls = pct >= 0 ? "up" : "down";
                text = $"{(pct >= 0 ? "↑" : "↓")} {Math.Abs(pct):0}% vs. last month";
            }
            yield return new StatCard("Total Bookings (Service)", _book.Total.ToString("N0"),
                Icons.Material.Outlined.CalendarMonth, text, cls);
        }
    }

    private List<PopItem> Popular => _items
        .Select(i => new PopItem(i, _book.PerService.GetValueOrDefault(i.Name)))
        .Where(p => p.Count > 0)
        .OrderByDescending(p => p.Count)
        .Take(5)
        .ToList();

    private static string Peso(decimal v) =>
        "₱" + v.ToString(v % 1 == 0 ? "N0" : "N2", System.Globalization.CultureInfo.InvariantCulture);

    private static string PriceText(ServiceItem s) =>
        s.MinPrice == s.MaxPrice ? Peso(s.MinPrice) : Peso(s.MinPrice) + " – " + Peso(s.MaxPrice);

    private static string CatSlug(string c) => new string(c.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();

    private static string CatIcon(string c) => c switch
    {
        "Grooming" => Icons.Material.Outlined.ContentCut,
        "Health & Wellness" => Icons.Material.Outlined.HealthAndSafety,
        "Add-ons" => Icons.Material.Outlined.AddCircleOutline,
        _ => Icons.Material.Outlined.Category
    };

    private static string ItemKey(ServiceItem s) => "s:" + s.ServiceItemId;

    // ---------- menu / modal plumbing ----------
    private void ToggleMenu(string key) => _openMenu = _openMenu == key ? null : key;

    private void CloseModal()
    {
        _modal = ModalKind.None;
        _error = null;
        _confirmAction = null;
    }

    private void Flash(string text) => _message = text;

    private async Task SaveModal()
    {
        _error = null;
        if (_modal == ModalKind.Service) await SaveService();
        else if (_modal == ModalKind.Pricing) await SavePricing();
        else if (_modal == ModalKind.Duration) await SaveDurations();
    }

    private async Task ConfirmDelete()
    {
        if (_confirmAction is not null) await _confirmAction();
        CloseModal();
    }

    // ---------- add / edit ----------
    private void OpenAdd()
    {
        _form = new ServiceForm();
        _editing = false;
        _error = null;
        _modal = ModalKind.Service;
    }

    private void OpenEdit(ServiceItem s)
    {
        _openMenu = null;
        _form = new ServiceForm
        {
            Id = s.ServiceItemId,
            Name = s.Name,
            Description = s.Description ?? "",
            Category = s.Category,
            Duration = s.DurationMinutes,
            Min = s.MinPrice,
            Max = s.MaxPrice,
            Active = s.IsActive,
            Sizes = s.SizeList.ToHashSet()
        };
        _editing = true;
        _error = null;
        _modal = ModalKind.Service;
    }

    private void ToggleSize(string size)
    {
        if (!_form.Sizes.Remove(size)) _form.Sizes.Add(size);
    }

    private async Task SaveService()
    {
        var name = _form.Name.Trim();
        if (name == "") { _error = "Service name is required."; return; }
        if (_form.Duration <= 0) { _error = "Duration must be at least 1 minute."; return; }
        if (_form.Min < 0 || _form.Max < _form.Min) { _error = "Max price must be at least the min price."; return; }

        var item = new ServiceItem
        {
            ServiceItemId = _form.Id,
            Name = name,
            Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
            Category = _form.Category,
            SizeApplicability = string.Join(",", ServiceItem.Sizes.Where(z => _form.Sizes.Contains(z))),
            DurationMinutes = _form.Duration,
            MinPrice = _form.Min,
            MaxPrice = _form.Max,
            IsActive = _form.Active
        };

        var err = _editing
            ? await CatalogSvc.UpdateAsync(item, _actor)
            : await CatalogSvc.AddAsync(item, _actor);
        if (err is not null) { _error = err; return; }

        var wasEditing = _editing;
        CloseModal();
        await Reload();
        Flash(wasEditing ? "Service updated." : "Service added.");
    }

    private async Task ToggleItem(ServiceItem s)
    {
        _openMenu = null;
        await CatalogSvc.SetActiveAsync(s.ServiceItemId, !s.IsActive, _actor);
        await Reload();
    }

    private void AskDelete(ServiceItem s)
    {
        _openMenu = null;
        _confirmText = $"Delete {s.Name}? This can't be undone.";
        _confirmAction = async () =>
        {
            await CatalogSvc.DeleteAsync(s.ServiceItemId, _actor);
            await Reload();
            Flash("Service deleted.");
        };
        _error = null;
        _modal = ModalKind.Confirm;
    }

    // ---------- quick actions: bulk pricing / durations ----------
    private void LoadBulk() => _bulk = _items.Select(i => new BulkRow
    {
        Id = i.ServiceItemId,
        Name = i.Name,
        Min = i.MinPrice,
        Max = i.MaxPrice,
        Minutes = i.DurationMinutes
    }).ToList();

    private void OpenPricing()
    {
        LoadBulk();
        _error = null;
        _modal = ModalKind.Pricing;
    }

    private void OpenDurations()
    {
        LoadBulk();
        _error = null;
        _modal = ModalKind.Duration;
    }

    private async Task SavePricing()
    {
        if (_bulk.Any(b => b.Min < 0 || b.Max < b.Min))
        {
            _error = "Each max price must be at least its min price.";
            return;
        }
        await CatalogSvc.SavePricingAsync(_bulk.Select(b => (b.Id, b.Min, b.Max)).ToList(), _actor);
        CloseModal();
        await Reload();
        Flash("Pricing saved.");
    }

    private async Task SaveDurations()
    {
        if (_bulk.Any(b => b.Minutes <= 0))
        {
            _error = "Each duration must be at least 1 minute.";
            return;
        }
        await CatalogSvc.SaveDurationsAsync(_bulk.Select(b => (b.Id, b.Minutes)).ToList(), _actor);
        CloseModal();
        await Reload();
        Flash("Durations saved.");
    }
}
