<div class="tools">
    <div class="search">
        <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Color="Color.Inherit" />
        <input type="text" placeholder="Search here..." disabled title="Search is not available yet" />
    </div>
    <div class="bell" title="Notifications">
        <MudIcon Icon="@Icons.Material.Outlined.Notifications" Size="Size.Small" Color="Color.Inherit" />
    </div>
    <AuthorizeView Roles="Admin">
        <div class="user" title="@context.User.Identity?.Name">
            <span class="avatar"><MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Color="Color.Inherit" /></span>
            <span>Admin</span>
        </div>
    </AuthorizeView>
</div>
