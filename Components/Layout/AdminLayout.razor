@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="logo"><MudIcon Icon="@Icons.Material.Filled.Pets" Color="Color.Inherit" /></div>
            <div class="brand-text">
                <div class="brand-name">Pawfect Admin</div>
                <div class="brand-sub">Pet Care. Made Simple.</div>
            </div>
        </div>

        <nav>
            <NavLink class="nav-item" href="admin" Match="NavLinkMatch.All" title="Dashboard">
                <MudIcon Icon="@Icons.Material.Outlined.Dashboard" Size="Size.Small" Color="Color.Inherit" /><span class="label">Dashboard</span>
            </NavLink>
            <NavLink class="nav-item" href="admin/users" title="Employee &amp; User Management">
                <MudIcon Icon="@Icons.Material.Outlined.ManageAccounts" Size="Size.Small" Color="Color.Inherit" /><span class="label">Employee &amp; User Management</span>
            </NavLink>
            <NavLink class="nav-item" href="admin/services" title="Service Catalog">
                <MudIcon Icon="@Icons.Material.Outlined.Sell" Size="Size.Small" Color="Color.Inherit" /><span class="label">Service Catalog</span>
            </NavLink>
            <NavLink class="nav-item" href="admin/inventory" title="Inventory &amp; FIFO">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" Color="Color.Inherit" /><span class="label">Inventory &amp; FIFO</span>
            </NavLink>
            <span class="nav-item disabled" title="Coming soon">
                <MudIcon Icon="@Icons.Material.Outlined.Assessment" Size="Size.Small" Color="Color.Inherit" /><span class="label">Reports &amp; Financial Auditing</span>
            </span>
            <span class="nav-item disabled" title="Coming soon">
                <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" Color="Color.Inherit" /><span class="label">Audit Trail / Activity Logs</span>
            </span>
        </nav>

        <div class="spacer"></div>
        <button type="button" class="nav-item logout" title="Log Out"
                @onclick="@(() => Nav.NavigateTo("/Identity/Account/Logout", forceLoad: true))">
            <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" Color="Color.Inherit" /><span class="label">Log Out</span>
        </button>
    </aside>

    <main class="main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#3B82C4",
            Secondary = "#C8742B"
        }
    };
}
