# Copy this file to "smtp.config" (same folder as Pawfect.exe / this project) and fill it in.
# smtp.config is git-ignored so the password never goes to GitHub.
#
# Gmail: turn on 2-Step Verification, then create an "App password"
#        (Google Account > Security > App passwords) and paste it below.
host=smtp.gmail.com
port=587
user=yourshop@gmail.com
password=your-16-letter-app-password
from=Pawfect <yourshop@gmail.com>
