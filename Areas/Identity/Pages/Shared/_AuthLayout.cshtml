@{
    var title = ViewData["Title"] as string ?? "Welcome";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Pawfect Admin</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="/auth.css" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <section class="auth-hero" aria-hidden="true">
            <div class="paw p1"></div><div class="paw p2"></div><div class="paw p3"></div>
            <div class="hero-brand">
                <div class="logo">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <circle cx="4.5" cy="9.5" r="2.5" /><circle cx="9" cy="5.5" r="2.5" />
                        <circle cx="15" cy="5.5" r="2.5" /><circle cx="19.5" cy="9.5" r="2.5" />
                        <path d="M17.34 14.86c-.87-1.02-1.6-1.89-2.48-2.91-.46-.54-1.05-1.08-1.75-1.32-.11-.04-.22-.07-.33-.09-.25-.04-.52-.04-.78-.04s-.53 0-.79.05c-.11.02-.22.05-.33.09-.7.24-1.28.78-1.75 1.32-.87 1.02-1.6 1.89-2.48 2.91-1.31 1.31-2.92 2.76-2.62 4.79.29 1.02 1.02 2.03 2.33 2.32.73.15 3.06-.44 5.54-.44h.18c2.48 0 4.81.58 5.54.44 1.31-.29 2.04-1.31 2.33-2.32.31-2.04-1.3-3.49-2.61-4.8z" />
                    </svg>
                </div>
                <div>
                    <div class="hero-name">Pawfect Admin</div>
                    <div class="hero-sub">Pet Care. Made Simple.</div>
                </div>
            </div>
            <div class="hero-copy">
                <h2>Run your pet shop and grooming business in one place.</h2>
                <ul>
                    <li>Service catalog &amp; pricing</li>
                    <li>Inventory with FIFO tracking</li>
                    <li>Reports &amp; financial auditing</li>
                    <li>Audit trail of every activity</li>
                </ul>
            </div>
        </section>

        <section class="auth-panel">
            <div class="auth-card">
                <div class="card-brand">
                    <div class="logo small">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                            <circle cx="4.5" cy="9.5" r="2.5" /><circle cx="9" cy="5.5" r="2.5" />
                            <circle cx="15" cy="5.5" r="2.5" /><circle cx="19.5" cy="9.5" r="2.5" />
                            <path d="M17.34 14.86c-.87-1.02-1.6-1.89-2.48-2.91-.46-.54-1.05-1.08-1.75-1.32-.11-.04-.22-.07-.33-.09-.25-.04-.52-.04-.78-.04s-.53 0-.79.05c-.11.02-.22.05-.33.09-.7.24-1.28.78-1.75 1.32-.87 1.02-1.6 1.89-2.48 2.91-1.31 1.31-2.92 2.76-2.62 4.79.29 1.02 1.02 2.03 2.33 2.32.73.15 3.06-.44 5.54-.44h.18c2.48 0 4.81.58 5.54.44 1.31-.29 2.04-1.31 2.33-2.32.31-2.04-1.3-3.49-2.61-4.8z" />
                        </svg>
                    </div>
                    <span>Pawfect Admin</span>
                </div>
                @RenderBody()
            </div>
        </section>
    </div>
</body>
</html>
