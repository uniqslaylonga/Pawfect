@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "/Areas/Identity/Pages/Shared/_AuthLayout.cshtml";
}

<h1>Welcome back</h1>
<p class="sub">Log in to the Pawfect admin to continue.</p>

@if (!string.IsNullOrEmpty(Model.InfoMessage))
{
    <div class="alert info">@Model.InfoMessage</div>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <div asp-validation-summary="ModelOnly" class="form-errors"></div>

    <div class="field">
        <label asp-for="Input.Login">Email or username</label>
        <input asp-for="Input.Login" type="text" autocomplete="username" placeholder="you@example.com" autofocus />
        <span asp-validation-for="Input.Login" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Input.Password">Password</label>
        <div class="pw-wrap">
            <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
            <button type="button" class="pw-toggle" id="pwToggle">Show</button>
        </div>
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>

    <div class="row-between">
        <label class="check"><input asp-for="Input.RememberMe" /> Remember me</label>
    </div>

    <button type="submit" class="btn-primary-full">Log in</button>
</form>

<p class="auth-foot">
    New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
</p>

<script>
    document.getElementById('pwToggle').addEventListener('click', function () {
        var input = document.getElementById('Input_Password');
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        this.textContent = show ? 'Hide' : 'Show';
    });
</script>
