@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
    Layout = "/Areas/Identity/Pages/Shared/_AuthLayout.cshtml";
}

<h1>Create your account</h1>
<p class="sub">Sign up to start using Pawfect.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <div asp-validation-summary="ModelOnly" class="form-errors"></div>

    <div class="field">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="you@example.com" autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Input.Password">Password</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="At least 6 characters" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Input.ConfirmPassword">Confirm password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Re-enter your password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary-full">Create account</button>
</form>

<p class="auth-foot">
    Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
</p>
